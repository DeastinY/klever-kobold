# Data is re-derivable from source; keep it out of git.
data/raw/
data/processed/
*.jsonl
*.parquet
*.sqlite

# ...but the benchmark and its hand-authored seeds are source, not derived data.
# The benchmark is a frozen test set: regenerating with a different --seed makes a
# new benchmark, it does not replace this one.
!eval/benchmark.jsonl
!eval/seeds/*.jsonl

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.ipynb_checkpoints/

# Training artifacts
outputs/
checkpoints/
wandb/
*.gguf
*.safetensors

# Secrets
.env

# Eval runs: raw responses are large and re-derivable; scored reports are not.
eval/runs/*.jsonl
eval/runs/*.log
!eval/runs/*.scores.json
!eval/runs/*.meta.json
